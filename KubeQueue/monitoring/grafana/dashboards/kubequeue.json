{
  "uid": "kubequeue",
  "title": "KubeQueue Metrics",
  "tags": [
    "kubequeue",
    "cnad"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Total Queue Depth",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "kubequeue_queue_depth",
          "legendFormat": "All queues",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue Depth by Priority",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "kubequeue_priority_queue_depth",
          "legendFormat": "{{priority}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Consumer Replica Recommendation (Simulated)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "kubequeue_consumer_replicas",
          "legendFormat": "Replicas",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Submitted vs Processed Tasks",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "kubequeue_tasks_submitted",
          "legendFormat": "Submitted",
          "refId": "A"
        },
        {
          "expr": "kubequeue_tasks_processed",
          "legendFormat": "Processed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Forecast Arrivals",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "kubequeue_forecast_arrivals",
          "legendFormat": "Forecast",
          "refId": "A"
        }
      ]
    }
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  }
}